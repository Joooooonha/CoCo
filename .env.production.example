COCO_DB_NAME=coco
COCO_DB_USER=coco
COCO_DB_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
COCO_PUBLIC_API_BASE_URL=https://api.cocorun.site
COCO_API_IMAGE=ghcr.io/joooooonha/coco-api:latest
COCO_MANAGEMENT_PORT=19090

COCO_DB_POOL_MAX_SIZE=10
COCO_DB_POOL_MIN_IDLE=2
COCO_HTTP_MAX_REQUEST_BODY_BYTES=262144
COCO_TOMCAT_MAX_THREADS=50
COCO_TOMCAT_MIN_SPARE_THREADS=5
COCO_TOMCAT_MAX_QUEUE_CAPACITY=50
COCO_TOMCAT_MAX_CONNECTIONS=200
COCO_TOMCAT_ACCEPT_COUNT=50

COCO_API_MEMORY_LIMIT=768m
COCO_API_CPU_LIMIT=1.5
COCO_POSTGRES_MEMORY_LIMIT=768m
COCO_POSTGRES_CPU_LIMIT=1.0
COCO_CLOUDFLARED_MEMORY_LIMIT=128m
COCO_CLOUDFLARED_CPU_LIMIT=0.5

# 소셜 로그인. 값은 각 개발자 콘솔에서 발급받아 채우고 절대 커밋하지 않는다.
# Naver: https://developers.naver.com  /  Kakao: https://developers.kakao.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
COCO_SOCIAL_APP_CALLBACK_URL=coco://oauth/callback
COCO_SOCIAL_NAVER_REDIRECT_URI=https://api.cocorun.site/api/v1/auth/social/naver/callback
COCO_SOCIAL_KAKAO_REDIRECT_URI=https://api.cocorun.site/api/v1/auth/social/kakao/callback

# 요소 사진 객체 저장소 (Cloudflare R2). 비워 두면 사진 API가 503으로 응답한다.
# 엔드포인트는 https://<account-id>.r2.cloudflarestorage.com 형식이고,
# 액세스 키는 R2 API 토큰 발급 화면에서 한 번만 보여준다.
COCO_STORAGE_ENDPOINT=
COCO_STORAGE_REGION=auto
COCO_STORAGE_BUCKET=coco-element-photos
COCO_STORAGE_ACCESS_KEY_ID=
COCO_STORAGE_SECRET_ACCESS_KEY=

# 사진 오프사이트 백업 (AWS S3). 비워 두면 야간 동기화가 건너뛴다.
# 버킷은 버전 관리를 켜고, 비현행 버전은 수명 주기 규칙으로 30일 뒤 정리한다.
COCO_OFFSITE_BUCKET=
COCO_OFFSITE_REGION=ap-northeast-2
COCO_OFFSITE_ACCESS_KEY_ID=
COCO_OFFSITE_SECRET_ACCESS_KEY=
